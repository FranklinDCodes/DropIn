{
    "note": "more epochs, less disparity",
    "seed": 42,
    "dataset": {
        "test_split": 0.15,
        "valid_split": 0.15,
        "bits": 32
    },
    "training": {
        "epochs": 350,
        "batch_size": 256,
        "lr": 0.0003
    },
    "models": [
        {
            "name": "InterNVG",
            "layers": [32, 10],
            "init": {
                "type": "interNVG",
                "kwargs": {
                    "starting_feature_var": 2.0,
                    "starting_neuron_var": 0.1 
                }
            }
        },
        {
            "name": "baseline_parity",
            "layers": [32, 10],
            "init": {"type": "glorot"}
        }
    ]
}